# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp number (the one that will receive/send messages)
MY_WHATSAPP_NUMBER=whatsapp:+972XXXXXXXXX

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar
# Path to your service account JSON key file, OR use OAuth credentials
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# The calendar ID to use (usually your email, or a specific calendar ID)
GOOGLE_CALENDAR_ID=primary

# Timezone
TIMEZONE=Asia/Jerusalem
